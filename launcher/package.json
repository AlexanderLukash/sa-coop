{
  "name": "sa-coop-launcher",
  "version": "0.2.24",
  "description": "LAN co-op launcher for GTA San Andreas",
  "author": "AlexanderLukash",
  "license": "MIT",
  "homepage": "https://github.com/AlexanderLukash/sa-coop",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node tools/ui-smoke.cjs",
    "test:native": "node tools/native-integration.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz --x64"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "ws": "^8.18.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "io.github.alexanderlukash.sacoop",
    "productName": "SA COOP Launcher",
    "directories": { "output": "out" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["node_modules/7zip-bin/**/*"],
    "win": { "target": ["nsis", "portable"], "signExecutable": false, "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "icon": "assets/icon.png", "category": "Game", "maintainer": "AlexanderLukash" }
  }
}
